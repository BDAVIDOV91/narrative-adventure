{
  "name": "narrative-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Story-driven astronomy education game for Bulgarian kids",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "npm run type-check:ts && npm run type-check:py",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,html,css}\"",
    "test": "vitest run",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "prepare": "husky",
    "type-check:ts": "tsc --noEmit",
    "type-check:py": "pyright"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.0",
    "@types/three": "0.185.4",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.9.6",
    "pyright": "1.1.408",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
